# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local processing & media storage
/.data/
/.tmp/
/uploads/
/generated-clips/

# whisper.cpp ggml models are 75MB-1.5GB each -> download them locally with
# `npm run setup:whisper` (see SETUP.md). They are intentionally NOT committed.
/models/*.bin

# The tiny face-detection weights under /models/face/ (~200KB) ARE committed - the
# pattern above only matches *.bin directly inside /models, so nothing to un-ignore.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
