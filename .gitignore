# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local SQLite database, processing temp files, and media storage
/data/
/.data/
/.tmp/
/uploads/
/generated-clips/

# whisper.cpp ggml models are 75MB-1.5GB each -> download them locally with
# `npm run setup:whisper` (see SETUP.md). They are intentionally NOT committed.
/models/*.bin
/bin/ffmpeg/

# The tiny YuNet face-detection model under /models/yunet/ (~230KB) IS committed;
# /models/*.bin only matches .bin files directly in /models, so the .onnx survives.

# Optional phase-9 models - downloaded, never committed:
#   npm run setup:yolox  -> models/yolox/yolox_nano.onnx   (~3.6MB, Apache-2.0)
#   npm run setup:asd    -> models/lr-asd/lr-asd-*.onnx   (exported from the MIT
#                          LR-ASD weights; see scripts/export-asd-onnx.py)
# The LR-ASD MIT licence text is NOT a model: it lives in docs/licenses/.
# Delete the leading "/" of an entry to keep a model in git instead.
/models/yolox/
/models/lr-asd/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Phase 7 benchmark output (throwaway SQLite, generated source, results)
/bench-render/
