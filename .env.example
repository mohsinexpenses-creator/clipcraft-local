# ---------------------------------------------------------------------------
# ClipCraft Local - environment template
#
#   1. copy this file to `.env.local`
#   2. fill in the paths and tuning you need (nothing here configures AI keys any more)
#   3. run `npm run setup:whisper` (downloads whisper.cpp binary + ggml model
#      and fills in WHISPER_CLI_PATH / WHISPER_MODEL_PATH automatically)
#
# API keys, worker concurrency, render/pipeline defaults and the profanity mode are NOT
# configured in this file - they live on the app's /settings page (see the last section
# for exactly which variables moved).
#
# `.env.local` is git-ignored. Both `npm run dev` and `npm run worker` load it
# (lib/errors.ts calls @next/env's loadEnvConfig), so the worker MUST be started
# from the repository root.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SQLite persistence and local job queue
# ---------------------------------------------------------------------------
# The parent directory is created automatically. Both the web app and worker
# must use the same path; stop/restart both processes after changing it.
DATABASE_PATH=./data/clipcraft.db

# ---------------------------------------------------------------------------
# AI keys and transcription provider: configured in the app, not here
# ---------------------------------------------------------------------------
# Viral-segment detection + hook/CTA text run through a fallback chain
# (lib/llm.ts -> LLM_PROVIDER_CHAIN), all of it on Google AI Studio:
#   gemini-3.8-flash -> gemini-3.6-flash -> gemini-3.5-flash-lite
#   -> gemini-3.1-flash-lite -> gemini-2.5-flash-lite
# Each model has its own free daily pool, and every key you add under
# Settings -> AI providers is tried on each model before the next model is
# attempted - so a second free key is real redundancy, not more quota on one key.
# Add keys there (get one free at https://aistudio.google.com/app/apikey) and use the
# page's Test button to check each one against Google before you save it.
#
# Deepgram (optional, paid) and the choice between Deepgram and local whisper.cpp are on
# the same card. `auto` prefers Deepgram when a key is stored there and falls back to
# whisper.cpp; forcing one engine means a missing setup then reports a real error.
#
# There is deliberately no GEMINI_API_KEY / DEEPGRAM_API_KEY in this template: Settings
# is the only source of truth for keys, so a value can never come from a file you are
# not looking at. To add another provider back, append an entry to LLM_PROVIDER_CHAIN in
# lib/llm.ts (Groq/Cerebras/Mistral/NIM/OpenRouter were all removed after live testing:
# Groq 413 + 429s, Cerebras 402 paid, Mistral ~1 RPM, NVIDIA NIM 404/410 + timeouts).

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# Local whisper.cpp - written automatically by `npm run setup:whisper`.
# Windows example: C:\path\to\clipcraft-local\.whisper\whisper-XXXX\build\bin\Release\whisper-cli.exe
# Model example:   C:\path\to\clipcraft-local\models\ggml-small.bin
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=

# `auto` detects the spoken language (needed for Urdu/Hindi/Punjabi content).
# Use `en` for slightly better English-only accuracy.
WHISPER_LANGUAGE=auto
# CPU threads for whisper. 0 = half of your cores.
WHISPER_THREADS=4

# ---------------------------------------------------------------------------
# FFmpeg (optional)
# ---------------------------------------------------------------------------
# ffmpeg-static (installed via npm) is used automatically. Set this only if that
# download failed behind a proxy, or if you want a full system build.
FFMPEG_PATH=

# Full FFmpeg distributions include ffprobe beside ffmpeg or on PATH. ffmpeg-static
# bundles only the ffmpeg executable; point this at ffprobe when not otherwise discoverable.
FFPROBE_PATH=

# Final H.264 quality. VIDEO_CRF is intentionally limited to 16-18 (lower = larger
# and higher quality); the default 17 is a high-quality balance. VIDEO_PRESET may be
# any libx264 preset; slow is the quality-first default, medium is faster.
VIDEO_CRF=17
VIDEO_PRESET=slow

# Move rendered captions only; positive delays them, negative advances them.
# Transcript/audio/profanity timestamps are not changed.
CAPTION_OFFSET_MS=0

# Keep a pre-caption/pre-overlay video+audio diagnostic beside the final clip.
SAVE_PRECAPTION_DEBUG=0

# Split-screen face framing (used consistently for 2, 3, and 4 cells).
# Face-box centre as a fraction of pane height (default 0.38; supported range 0.25-0.55).
SPLIT_FACE_TARGET_FRAC=0.38
# Maximum crop magnification (default 1.5; supported range 1-2).
# Use 1.0 for no enlargement, or up to 2.0 for tighter but softer crops.
SPLIT_ZOOM=1.5

# ---------------------------------------------------------------------------
# Uploads (long podcast recordings)
# ---------------------------------------------------------------------------
# Source videos are stored here. In-progress chunked uploads live in
# <UPLOAD_DIR>/.upload-sessions/<id>/ and are swept after UPLOAD_SESSION_TTL_HOURS.
UPLOAD_DIR=uploads

# There is NO upload size limit by default - a 3-hour podcast is a normal input and the
# browser streams it to disk in chunks. Set a number here only if you want a guard rail
# on a small disk (0 or empty = unlimited).
MAX_UPLOAD_MB=0

# Size of each chunk the resumable uploader sends. Smaller chunks survive flaky
# connections better; larger chunks mean fewer requests on a fast local disk.
UPLOAD_CHUNK_MB=8

# The single-request POST /api/upload endpoint has to buffer the whole multipart body in
# memory, so bodies above this size are refused with a pointer to /api/upload/session.
# The web UI never uses that endpoint, so this does not limit what you can upload.
MAX_MULTIPART_MB=256

# Unfinished uploads (browser closed mid-upload) are deleted after this many hours.
UPLOAD_SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# App / worker tuning (all optional)
# ---------------------------------------------------------------------------
# `npm run dev` binds to 127.0.0.1 by default (nothing else on your LAN can reach
# the app). For LAN access, start it with `npm run dev -- --hostname 0.0.0.0`.
PORT=3000

# `next dev` blocks cross-origin requests for its own dev assets, which breaks HMR when
# the app is opened through a tunnel or a LAN hostname. Comma-separated hostnames, no
# scheme or port: ALLOWED_DEV_ORIGINS="*.ngrok-free.app,my-box.local".
ALLOWED_DEV_ORIGINS=

# How hard the worker pushes - clip renders at once, detections at once, Chrome tabs per
# render - is set on Settings -> Worker & limits (the two loop sizes apply when the worker
# starts; the tab count applies to the next render). Nothing here configures them.

# Log level for the Remotion render: verbose | info | warn | error
REMOTION_LOG_LEVEL=info

# Set to 1 to re-enable the (fragile) YouTube download path on the upload page.
# Off by default: upload a local file instead.
ENABLE_YT_IMPORT=0

# ---------------------------------------------------------------------------
# What this file still owns, and what moved to /settings
# ---------------------------------------------------------------------------
# Settings owns these, and they are NOT read from here at all:
#   pipeline defaults, render clip defaults, the Gemini key pool, the Deepgram key
#   + model + engine choice, worker concurrency, Chrome tabs per render, and the
#   profanity audio mode (mute / beep / leave the word).
# `GEMINI_API_KEY`, `DEEPGRAM_API_KEY`, `DEEPGRAM_MODEL`, `WORKER_CONCURRENCY`,
# `VIRAL_CONCURRENCY`, `REMOTION_CONCURRENCY`, `AUTO_RENDER_CAPTION_ENGINE` and
# `PROFANITY_AUDIO_MODE` are therefore gone from this template. If yours still has
# them, the Settings page points that out (it can copy the keys in for you once) and
# then you can delete the lines.
#
# Everything above this section is still read from here, because it has no form field:
# database path, whisper binary/model/language/threads, FFmpeg paths and quality,
# caption offset, split-screen framing, upload limits, dev server host/origin, Remotion
# log level and the two optional per-attempt ceilings:
#   WHISPER_TIMEOUT_MINUTES  - default scales with the recording length (1 min of
#                              audio per minute of video, never under 10 minutes)
#   REMOTION_TIMEOUT_MINUTES - one overlay render, default 60
# Both are per-attempt caps; on timeout the job re-queues with backoff.
# WHISPER_TIMEOUT_MINUTES=
# REMOTION_TIMEOUT_MINUTES=
