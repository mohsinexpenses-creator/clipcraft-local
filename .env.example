# ---------------------------------------------------------------------------
# ClipCraft Local - environment template
#
#   1. copy this file to `.env.local`
#   2. fill in the paths and tuning you need (nothing here configures AI keys any more)
#   3. run `npm run setup:whisper` (downloads whisper.cpp binary + ggml model
#      and fills in WHISPER_CLI_PATH / WHISPER_MODEL_PATH automatically)
#
# API keys, worker concurrency, render/pipeline defaults and the profanity mode are NOT
# configured in this file - they live on the app's /settings page (see the last section
# for exactly which variables moved).
#
# `.env.local` is git-ignored. Both `npm run dev` and `npm run worker` load it
# (lib/errors.ts calls @next/env's loadEnvConfig), so the worker MUST be started
# from the repository root.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SQLite persistence and local job queue
# ---------------------------------------------------------------------------
# The parent directory is created automatically. Both the web app and worker
# must use the same path; stop/restart both processes after changing it.
DATABASE_PATH=./data/clipcraft.db

# ---------------------------------------------------------------------------
# AI keys and transcription provider: configured in the app, not here
# ---------------------------------------------------------------------------
# Viral-segment detection + hook/CTA text run through a fallback chain
# (lib/llm.ts -> LLM_PROVIDER_CHAIN), all of it on Google AI Studio:
#   gemini-3.8-flash -> gemini-3.6-flash -> gemini-3.5-flash-lite
#   -> gemini-3.1-flash-lite -> gemini-2.5-flash-lite
# Each model has its own free daily pool, and every key you add under
# Settings -> AI providers is tried on each model before the next model is
# attempted - so a second free key is real redundancy, not more quota on one key.
# Add keys there (get one free at https://aistudio.google.com/app/apikey) and use the
# page's Test button to check each one against Google before you save it.
#
# Deepgram (optional, paid) is configured on the same card. It is the supported
# transcription engine in this build; the worker reads the saved key/model per job.
#
# B-roll image providers are on the same page, one card each:
#   Pexels / Pixabay / Unsplash  - optional keys for landscape B-roll cards
#   Wikipedia article images - no key is needed for full-screen named entities.
#   Keyword cards use the keyed stock providers above.
# PEXELS_API_KEY, PIXABAY_API_KEY and UNSPLASH_API_KEY are NOT read at runtime
# either; they are only offered for the one-time "Copy into Settings" action.
#
# There is deliberately no GEMINI_API_KEY / DEEPGRAM_API_KEY in this template: Settings
# is the only source of truth for keys, so a value can never come from a file you are
# not looking at. To add another provider back, append an entry to LLM_PROVIDER_CHAIN in
# lib/llm.ts (Groq/Cerebras/Mistral/NIM/OpenRouter were all removed after live testing:
# Groq 413 + 429s, Cerebras 402 paid, Mistral ~1 RPM, NVIDIA NIM 404/410 + timeouts).

# ---------------------------------------------------------------------------
# Deepgram transcription transport
# ---------------------------------------------------------------------------
# A raw 16 kHz mono WAV is about 1.9 MB per minute and can cause Deepgram's
# HTTP 408 SLOW_UPLOAD response on a slow connection. `mp3` is the compact,
# speech-oriented default (32 kb/s); use `flac` for lossless input or `wav` to
# restore the legacy raw PCM path while troubleshooting. Restart the worker after
# changing .env.local so it reloads the environment.
DEEPGRAM_AUDIO_FORMAT=mp3

# ---------------------------------------------------------------------------
# FFmpeg (optional)
# ---------------------------------------------------------------------------
# ffmpeg-static (installed via npm) is used automatically. Set this only if that
# download failed behind a proxy, or if you want a full system build. A saved
# Settings -> Paths & binaries FFmpeg path takes precedence without a restart.
FFMPEG_PATH=

# Full FFmpeg distributions include ffprobe beside ffmpeg or on PATH. ffmpeg-static
# bundles only the ffmpeg executable; point this at ffprobe when not otherwise discoverable.
FFPROBE_PATH=

# Final H.264 quality. VIDEO_CRF is intentionally limited to 16-18 (lower = larger
# and higher quality); the default 17 is a high-quality balance. VIDEO_PRESET may be
# any libx264 preset; slow is the quality-first default, medium is faster.
VIDEO_CRF=17
VIDEO_PRESET=slow

# Move rendered captions only; positive delays them, negative advances them.
# Transcript/audio/profanity timestamps are not changed.
CAPTION_OFFSET_MS=0

# Keep a pre-caption/pre-overlay video+audio diagnostic beside the final clip.
SAVE_PRECAPTION_DEBUG=0

# Join safe, sparse same-layer transparent PNG ranges into one FFconcat input before
# the existing single final FFmpeg encode. This reduces image inputs/overlay filters;
# it never combines overlaps or off-frame timings. Set to 0 for direct per-range inputs.
FFMPEG_OVERLAY_CONCAT=1

# Split-screen face framing (used consistently for 2, 3, and 4 cells).
# Face-box centre as a fraction of pane height (default 0.38; supported range 0.25-0.55).
SPLIT_FACE_TARGET_FRAC=0.38
# Maximum crop magnification (default 1.5; supported range 1-2).
# Use 1.0 for no enlargement, or up to 2.0 for tighter but softer crops.
SPLIT_ZOOM=1.5

# ---------------------------------------------------------------------------
# Uploads (long podcast recordings)
# ---------------------------------------------------------------------------
# Source videos are stored here. In-progress chunked uploads live in
# <UPLOAD_DIR>/.upload-sessions/<id>/ and are swept after UPLOAD_SESSION_TTL_HOURS.
# A saved Settings -> Paths & binaries upload folder takes precedence for new uploads.
UPLOAD_DIR=uploads

# Custom font storage is configured on Settings -> Paths & binaries, not here.
# The default is ./custom-fonts. Direct-local Style presets accepts signature-checked
# .ttf/.otf/.woff/.woff2 files up to 5 MB and keeps each registry entry's original folder.

# There is NO upload size limit by default - a 3-hour podcast is a normal input and the
# browser streams it to disk in chunks. Set a number here only if you want a guard rail
# on a small disk (0 or empty = unlimited).
MAX_UPLOAD_MB=0

# Size of each chunk the resumable uploader sends. Smaller chunks survive flaky
# connections better; larger chunks mean fewer requests on a fast local disk.
UPLOAD_CHUNK_MB=8

# The single-request POST /api/upload endpoint has to buffer the whole multipart body in
# memory, so bodies above this size are refused with a pointer to /api/upload/session.
# The web UI never uses that endpoint, so this does not limit what you can upload.
MAX_MULTIPART_MB=256

# Unfinished uploads (browser closed mid-upload) are deleted after this many hours.
UPLOAD_SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# App / worker tuning (all optional)
# ---------------------------------------------------------------------------
# `npm run dev` binds to 127.0.0.1 by default (nothing else on your LAN can reach
# the app). For LAN access, start it with `npm run dev -- --hostname 0.0.0.0`.
PORT=3000

# `next dev` blocks cross-origin requests for its own dev assets, which breaks HMR when
# the app is opened through a tunnel or a LAN hostname. Comma-separated hostnames, no
# scheme or port: ALLOWED_DEV_ORIGINS="*.ngrok-free.app,my-box.local".
ALLOWED_DEV_ORIGINS=

# How hard the worker pushes - clip renders at once, detections at once, Chrome tabs per
# render - is set on Settings -> Worker & limits (the two loop sizes apply when the worker
# starts; the tab count applies to the next render). Nothing here configures them.

# Log level for the Remotion render: verbose | info | warn | error
REMOTION_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional LLM latency safeguards (OFF by default, preserving the full chain)
# ---------------------------------------------------------------------------
# Set LLM_TASK_ROUTING_ENABLED=1 to use task-specific timeouts/token ceilings:
# viral detection gets the quality route; B-roll gets 20 seconds; hook, overlay
# text and safety review use 15-20-second lite-model routes with Gemini thinking
# disabled. Every skipped model is logged. Disable the flag to restore the prior
# all-model, 120-second behavior exactly.
LLM_TASK_ROUTING_ENABLED=0

# Per-model deadlines for routed tasks. A quality (viral-detection) attempt gets
# this many seconds, scaled up with transcript size and hard-capped by the route
# ceiling (90s). Fast routes (B-roll planning, hook, overlay, safety) use the
# fast value flat.
LLM_QUALITY_TIMEOUT_SECONDS=45
LLM_FAST_TIMEOUT_SECONDS=20

# Hedged requests: "quality,fast" seconds. When the current model has not
# answered in this long, the next model starts CONCURRENTLY and the first usable
# answer wins (the loser is aborted and logged as "hedge: ..."). Empty = off,
# which preserves the strict one-model-at-a-time order.
LLM_HEDGE_AFTER_SECONDS=

# A model that returns HTTP 404/410 is marked unavailable for the rest of the
# worker process (logged once, with the replacement the provider suggests) and a
# model that 400s on a thinking config is retried once without it, remembered per
# model. Both behaviours are always on: they only skip work that would fail again.

# Set LLM_CIRCUIT_BREAKER_ENABLED=1 to temporarily skip a model after consecutive
# timeout/network/429/5xx failures. This process-local safeguard has no effect on
# successful models and does not persist across worker restarts.
LLM_CIRCUIT_BREAKER_ENABLED=0
# Optional bounds: failures 1-10 (default 2), cooldown seconds 5-3600 (default 90).
LLM_CIRCUIT_FAILURE_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_SECONDS=90

# Viral detection already returns risky phrases for each clip. Those phrases are
# reused at render time instead of a second LLM safety pass. Set this only when
# auditing a policy change: it forces the optional contextual LLM review too.
FORCE_LLM_SAFETY_REVIEW=0

# B-roll images normally render only their scheduled active frame windows, then
# FFmpeg rebases each sequence to that exact final-timeline frame. Set to 0 only
# to roll back to the legacy full-timeline transparent B-roll sequence.
BROLL_ACTIVE_RANGE_RENDERING=1

# Experimental pixel-saving card canvas. When set to 1, only landscape B-roll
# cards render as smaller transparent PNGs and FFmpeg places them at their exact
# 1080x1920 origin. The automated start/middle/end browser gate passed here
# (exact, 0.999999, and 0.999995 SSIM), but no representative source clip or
# audio/SFX run is available in this sandbox. Keep 0 until that broader render
# review is recorded. If a cropped card sequence is fully transparent, the worker
# warns and retries that card at 1080x1920.
BROLL_CARD_CROPPED_CANVAS=0

# Jimp card preparation is bounded so 10-15 B-roll images do not create an
# unbounded RAM spike. Set to 1 for the legacy serial behavior. Core-aware default
# (Phase 7): 4 - each worker is bounded by one card's crop, not by the plan.
BROLL_IMAGE_PREP_CONCURRENCY=4

# Exact sync (Phase 4). Every B-roll moment is re-anchored to the transcript word
# the analysis pointed at (anchorText, cross-checked against wordIndex) and drawn
# from that word's start, floored onto the render frame grid - so a card can
# appear at most ONE frame early and never late. A moment that cannot be anchored
# is dropped instead of being placed on the model's guessed seconds. Set to 0 to
# roll back to the model's own start times.
BROLL_EXACT_SYNC=1
# One "[BROLL-SYNC] id=... anchorText=... wordStart=... finalStart=... delta_ms="
# line per placed card plus a summary. Set to 0 to keep only the summary line.
BROLL_SYNC_LOG=1

# Which renderer paints the transparent B-roll landscape cards.
#   remotion (default) - Chromium, one PNG sequence per card, unchanged behaviour.
#   native             - lib/broll/native.ts rasterises the same frames from the
#                        same brollFrameStyle() numbers: identical PNG naming,
#                        frame range, canvas and cache key, no browser. Only
#                        landscape cards are handled; full-screen items stay on
#                        Remotion. Measure it with `npm run bench:broll-native`
#                        and gate it with `npm run verify:broll-native` (compares
#                        both renderers frame by frame: SSIM >= 0.995 inside the
#                        card box plus a max channel difference).
BROLL_RENDERER=remotion

# Speaker-focus camera. locked (default) is the event-based locked camera: one
# anchor per speaker turn and per source shot, a 10%x8% face-centre dead zone, one
# 0.35s re-centre when the face really leaves it, 0.1s speaker switches and hard
# switches on source shot cuts (a handful of keyframes per minute, no drifting).
# Set to legacy to restore the previous continuous follow exactly.
CAMERA_MODE=locked
CAMERA_HOLD_DEADZONE_PCT=10
CAMERA_HOLD_DEADZONE_Y_PCT=8
# Seconds the face must stay outside the dead zone before the one re-centre.
CAMERA_HOLD_CONFIRM_SECONDS=0.4
# One eased re-centre per real departure (never more than this long).
CAMERA_RECENTRE_SECONDS=0.35
CAMERA_RECENTRE_LOOKBACK_SECONDS=0.5
# glide (default) = 0.1s speaker-change glide; cut = instant switch.
CAMERA_SWITCH_MODE=glide
SPEAKER_GLIDE_SECONDS=0.1
# Opt-in listener cutaways (off by default): hold the speaker 6s, then show a
# listener for 2s. A listener must be live and comparably sized, on screen in
# >=80% of the cutaway, co-visible with the speaker in the same shot and
# centerable - otherwise the cutaway is skipped and the reason is logged.
SPEAKER_CUTAWAYS=off
SPEAKER_FOCUS_HOLD_SECONDS=6
SPEAKER_SWITCH_HOLD_SECONDS=2
SPEAKER_CUTAWAY_PICK=random
# Safety cap on planned camera moves (a handful per minute is normal).
CAMERA_KEYFRAME_CAP=400
# A filter graph longer than this goes to -filter_complex_script (when the
# installed FFmpeg supports it) instead of onto the command line.
CAMERA_KEYFRAME_MAX_CHARS=24000
# Opt-in drift removal for the LEGACY camera path only (0 = exact old output).
CAMERA_LEGACY_DETREND=0
# Source shot-cut detection: one small grayscale scene decode beside the ASD
# frame extraction. The speaker camera switches ON the cut frame, never across it.
# Set to 0 to skip the probe (no cut boundaries, old interpolation returns).
SHOT_CUT_DETECTION=1
SHOT_CUT_THRESHOLD=0.3
SHOT_CUT_MIN_GAP_SECONDS=0.5

# Adaptive active-speaker sampling starts at <=4fps / 240 frames / 960px JPEGs,
# interpolates adjacent face positions for 8fps analysis, and retries the <=8fps /
# 480-frame quality profile only for weak evidence. Set to 0 for quality-only.
ASD_ADAPTIVE_SAMPLING=1
# balanced is the default wide-shot profile. legacy-fast restores the previous
# 640px JPEG first pass; quality starts on the 8fps/480-frame profile directly.
ASD_INITIAL_PROFILE=balanced
# Bounded concurrent JPEG decode + YuNet inference (1-3). Tracker and speaker
# fusion remain sequential. Core-aware default (Phase 7): floor(threads/6)
# clamped to 2..3 - 3 on a 24-thread host, 2 on a laptop. Set to 1 for the former
# serial detector path.
ASD_DETECTION_CONCURRENCY=2
# After three small-face wide-shot samples, skip the redundant full-frame YuNet
# pass and retain tile scans. Set to 0 for the prior full-frame-plus-tiles path.
ASD_SKIP_FULL_FRAME_ON_WIDE_SHOTS=1
# Cache exact ASD results by immutable source metadata/window/profile. The cache is
# bounded LRU storage under .tmp by default. Set to 0 to always recompute ASD.
ASD_CACHE_ENABLED=1
ASD_CACHE_MAX_MB=512
# ASD_CACHE_DIR=

# Speaker-focus camera. locked (default) is the event-based locked camera: one
# anchor per speaker turn and per source shot, a 10%x8% face-centre dead zone, one
# 0.35s re-centre when the face really leaves it, 0.1s speaker switches and hard
# switches on source shot cuts (a handful of keyframes per minute, no drifting).
# Set to legacy to restore the previous continuous follow exactly.
CAMERA_MODE=locked
CAMERA_HOLD_DEADZONE_PCT=10
CAMERA_HOLD_DEADZONE_Y_PCT=8
# Seconds the face must stay outside the dead zone before the one re-centre.
CAMERA_HOLD_CONFIRM_SECONDS=0.4
# One eased re-centre per real departure (never more than this long).
CAMERA_RECENTRE_SECONDS=0.35
CAMERA_RECENTRE_LOOKBACK_SECONDS=0.5
# glide (default) = 0.1s speaker-change glide; cut = instant switch.
CAMERA_SWITCH_MODE=glide
SPEAKER_GLIDE_SECONDS=0.1
# Opt-in listener cutaways (off by default): hold the speaker 6s, then show a
# listener for 2s. A listener must be live and comparably sized, on screen in
# >=80% of the cutaway, co-visible with the speaker in the same shot and
# centerable - otherwise the cutaway is skipped and the reason is logged.
SPEAKER_CUTAWAYS=off
SPEAKER_FOCUS_HOLD_SECONDS=6
SPEAKER_SWITCH_HOLD_SECONDS=2
SPEAKER_CUTAWAY_PICK=random
# Safety cap on planned camera moves (a handful per minute is normal).
CAMERA_KEYFRAME_CAP=400
# A filter graph longer than this goes to -filter_complex_script (when the
# installed FFmpeg supports it) instead of onto the command line.
CAMERA_KEYFRAME_MAX_CHARS=24000
# Opt-in drift removal for the LEGACY camera path only (0 = exact old output).
CAMERA_LEGACY_DETREND=0
# Source shot-cut detection: one small grayscale scene decode beside the ASD
# frame extraction. The speaker camera switches ON the cut frame, never across it.
# Set to 0 to skip the probe (no cut boundaries, old interpolation returns).
SHOT_CUT_DETECTION=1
SHOT_CUT_THRESHOLD=0.3
SHOT_CUT_MIN_GAP_SECONDS=0.5

# Experimental sparse captions: render only intervals containing captions, hook or
# CTA, rebased by FFmpeg like B-roll. It activates only when intervals are genuinely
# sparse (not dense speech) and has a visual rollback to the full transparent timeline.
CAPTION_ACTIVE_RANGE_RENDERING=0

# Experimental Phase 4 pixel-saving canvas. When set to 1, the combined
# caption/hook/CTA layer paints into one conservative full-width vertical band;
# FFmpeg restores that band at its exact virtual 1080x1920 origin. Keep 0 until
# the five-frame cropped/full visual and audio/SFX gate is recorded on this host.
CAPTION_BAND_CROPPED_CANVAS=0

# Phase 5 reusable transparent-frame cache. Completed caption and B-roll overlay
# sequences are SHA-256 keyed by their visual inputs, font/image identity, timeline
# frames and physical canvas. A hit is hard-linked/copied into the current job's
# temporary workdir, so Settings -> Worker & limits -> Clear caches cannot break a
# running FFmpeg job. Set to 0 for the old render-every-overlay path.
OVERLAY_RENDER_CACHE_ENABLED=1
# Bounded LRU cache under <tempDir>/overlay-frame-cache by default. Entries older
# than this are pruned when a completed sequence is published; source videos, B-roll
# downloads, fonts and finished clips are never stored or deleted here.
OVERLAY_RENDER_CACHE_MAX_MB=1024
OVERLAY_RENDER_CACHE_MAX_AGE_DAYS=14
# OVERLAY_RENDER_CACHE_DIR=

# Fixed-anchor speaker-focus B-roll renders beside active-speaker detection by
# default. It preserves the same card anchor/timing and waits for sibling cleanup on
# failure/cancellation. Set to 0 for the prior sequential behavior. A split-screen
# clip also overlaps safely when every B-roll item is fullscreen; a landscape card
# still waits for ASD-derived face-safe placement.
RENDER_PARALLEL_BROLL_ASD=1
# Caps Chrome tabs in that parallel B-roll branch only (1-32), while respecting a
# smaller Settings -> Worker & limits tab value. Core-aware default (Phase 7):
# floor(threads/6) clamped to 2..4 - 4 on a 24-thread host.
RENDER_PARALLEL_BROLL_CONCURRENCY=2
# Image2 overlay-input queue. 2 is the baseline-safe default; try 16/32 only
# with a benchmark on this host, then return to 2 to roll back.
FFMPEG_OVERLAY_THREAD_QUEUE_SIZE=2
# Threads passed to FFmpeg (1-64). Core-aware default (Phase 7): whatever is left
# after the Remotion tabs and ASD workers, so the encode never claims the whole
# host. Set it explicitly to pin the encoder on a shared machine.
# FFMPEG_THREADS=

# --- Core-aware parallelism (Phase 7) --------------------------------------
# Every concurrency default above is derived from the logical CPU count instead of
# a hard-coded number, and every explicit value above still wins:
#   Remotion tabs        floor(threads * 0.5), clamped 2..12
#   B-roll/ASD workers   floor(threads / 6),  clamped 2..4 (ASD also capped at 3)
#   Image preparation    fixed 4 
#   FFmpeg threads       threads - tabs - ASD workers, clamped 1..32
# On a 24-thread host that is 12 tabs, 4 B-roll workers, 3 ASD workers, 4 image
# workers and 9 FFmpeg threads - 24 of 24 threads. Each render logs the resolved
# profile once as "[RENDER-DIAG] stage=runtime event=parallelism ...".
# Overrides for benchmarking or an unusual host:
# CLIPCRAFT_LOGICAL_THREADS forces the thread count the derivation uses.
# (REMOTION_CONCURRENCY itself moved to Settings -> Worker & limits; an explicit
# value there - or in the environment - always beats the derived default.)
# CLIPCRAFT_LOGICAL_THREADS=

# Set to 1 to re-enable the (fragile) YouTube download path on the upload page.
# Off by default: upload a local file instead.
ENABLE_YT_IMPORT=0

# ---------------------------------------------------------------------------
# What this file still owns, and what moved to /settings
# ---------------------------------------------------------------------------
# Settings owns these, and they are NOT read from here at all:
#   pipeline defaults, render clip defaults, the Gemini key pool, the Deepgram key
#   + model + engine choice, worker concurrency, Chrome tabs per render, and the
#   profanity audio mode (mute / beep / leave the word).
# `GEMINI_API_KEY`, `DEEPGRAM_API_KEY`, `DEEPGRAM_MODEL`, `PEXELS_API_KEY`,
# `PIXABAY_API_KEY`, `UNSPLASH_API_KEY`, `WORKER_CONCURRENCY`,
# `VIRAL_CONCURRENCY`, `REMOTION_CONCURRENCY` and `PROFANITY_AUDIO_MODE` are
# therefore gone from this template. If yours still has
# them, the Settings page points that out (it can copy the keys in for you once) and
# then you can delete the lines.
#
# Everything above this section is still read from here, because it has no form field:
# database path, whisper binary/model/language/threads, FFmpeg paths and quality,
# caption offset, split-screen framing, upload limits, dev server host/origin, Remotion
# log level and the two optional per-attempt ceilings:
#   WHISPER_TIMEOUT_MINUTES  - default scales with the recording length (1 min of
#                              audio per minute of video, never under 10 minutes)
#   REMOTION_TIMEOUT_MINUTES - one overlay render, default 60
# Both are per-attempt caps; on timeout the job re-queues with backoff.
# WHISPER_TIMEOUT_MINUTES=
# REMOTION_TIMEOUT_MINUTES=

# --- Logging ---------------------------------------------------------------
# Log lines already start with [HH:MM:SS]. Set to 1 to add milliseconds
# ([HH:MM:SS.mmm]) when a job is slow and the ordering of LLM/FFmpeg lines
# matters more than readability.
LOG_TIMESTAMP_MS=0
