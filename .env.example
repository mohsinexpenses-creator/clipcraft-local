# ---------------------------------------------------------------------------
# ClipCraft Local - environment template
#
#   1. copy this file to `.env.local`
#   2. fill in the keys you need
#   3. run `npm run setup:whisper` (downloads whisper.cpp binary + ggml model
#      and fills in WHISPER_CLI_PATH / WHISPER_MODEL_PATH automatically)
#
# `.env.local` is git-ignored. Both `npm run dev` and `npm run worker` load it
# (lib/errors.ts calls @next/env's loadEnvConfig), so the worker MUST be started
# from the repository root.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MongoDB  (required)
# ---------------------------------------------------------------------------
# Local Docker:
#   docker run -d --name clipcraft-mongo -p 27017:27017 -v clipcraft_mongo:/data/db mongo:7
# Or a MongoDB Atlas free-tier connection string.
# The database name is hard-coded to `clipcraft` (lib/db.ts).
#
# NOTE: inside WSL2 use 127.0.0.1, not `localhost` - name resolution can pick
# IPv6 (::1) and the Mongo driver then fails to connect.
MONGODB_URI=mongodb://127.0.0.1:27017

# ---------------------------------------------------------------------------
# Redis / BullMQ  (required for clip rendering)
# ---------------------------------------------------------------------------
#   docker run -d --name clipcraft-redis -p 6379:6379 redis:7-alpine
# BullMQ needs Redis >= 6.2.
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# AI / LLM fallback chain  (at least ONE key required)
# ---------------------------------------------------------------------------
# Viral-segment detection + hook/CTA text run through a fallback chain
# (lib/llm.ts -> LLM_PROVIDER_CHAIN): the first provider with a working key
# handles the request; on 429/503 or any other error it automatically moves
# to the next one. Keys you leave empty are skipped (with a log line).
#
# The LLM chain now runs on Google AI Studio only (2 slots, re-verified 2026-09-27):
#   Google AI Studio (gemini-3.6-flash) -> Google AI Studio (gemini-3.8-flash)
# The two Flash models share GEMINI_API_KEY but draw from SEPARATE free daily
# pools (~1,500 RPD each), so the second slot is real 503-redundancy.
# The other providers were removed after live testing: Groq 413 (free per-minute
# INPUT cap) + 429s, Cerebras 402 (paid), Mistral 429 (~1 RPM), NVIDIA NIM 410
# (retired models) + timeouts. To add a provider back, append an entry to
# LLM_PROVIDER_CHAIN in lib/llm.ts.
#
# Key value:
#   GEMINI_API_KEY      -> 2 slots, ~3,000 RPD combined, 1M context, Urdu/Hindi strong
#   (GROQ / CEREBRAS / MISTRAL / NVIDIA / OPENROUTER keys below are currently
#    IGNORED by the chain - kept only so you can re-enable a provider later)
GROQ_API_KEY=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
GEMINI_API_KEY=AQ.Ab8RN6LFnnIwPZIro8doASsf-lERL10EhNn04y8D1gKEPqp6Sg
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=csk-5cypw45rwv86hjdnyxjd9mrxv3trhehyfmcnwrrtk4eywd2w
MISTRAL_API_KEY=mstrl_34rY4d1IcbLMpJ7sriKJWRyly1bEUmgd_0mIUrM
NVIDIA_API_KEY=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

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# OPTIONAL. If DEEPGRAM_API_KEY is set it WINS over local whisper.cpp
# (lib/whisper.ts -> getPlannedTranscriptionEngine). Leave it empty to stay free/local.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Local whisper.cpp - written automatically by `npm run setup:whisper`.
# Windows example: C:\path\to\clipcraft-local\.whisper\whisper-XXXX\build\bin\Release\whisper-cli.exe
# Model example:   C:\path\to\clipcraft-local\models\ggml-small.bin
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=

# `auto` detects the spoken language (needed for Urdu/Hindi/Punjabi content).
# Use `en` for slightly better English-only accuracy.
WHISPER_LANGUAGE=auto
# CPU threads for whisper. 0 = half of your cores.
WHISPER_THREADS=4

# ---------------------------------------------------------------------------
# FFmpeg (optional)
# ---------------------------------------------------------------------------
# ffmpeg-static (installed via npm) is used automatically. Set this only if that
# download failed behind a proxy, or if you want a full system build.
# Remotion ships its own ffmpeg, so this only affects the trim/crop/concat steps.
FFMPEG_PATH=

# ---------------------------------------------------------------------------
# Uploads (long podcast recordings)
# ---------------------------------------------------------------------------
# Source videos are stored here. In-progress chunked uploads live in
# <UPLOAD_DIR>/.upload-sessions/<id>/ and are swept after UPLOAD_SESSION_TTL_HOURS.
UPLOAD_DIR=uploads

# There is NO upload size limit by default - a 3-hour podcast is a normal input and the
# browser streams it to disk in chunks. Set a number here only if you want a guard rail
# on a small disk (0 or empty = unlimited).
MAX_UPLOAD_MB=0

# Size of each chunk the resumable uploader sends. Smaller chunks survive flaky
# connections better; larger chunks mean fewer requests on a fast local disk.
UPLOAD_CHUNK_MB=8

# The single-request POST /api/upload endpoint has to buffer the whole multipart body in
# memory, so bodies above this size are refused with a pointer to /api/upload/session.
# The web UI never uses that endpoint, so this does not limit what you can upload.
MAX_MULTIPART_MB=256

# Unfinished uploads (browser closed mid-upload) are deleted after this many hours.
UPLOAD_SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# App / worker tuning (all optional)
# ---------------------------------------------------------------------------
# `npm run dev` binds to 127.0.0.1 by default (nothing else on your LAN can reach
# the app). Use `npm run dev:lan` if you really want to expose it on 0.0.0.0.
PORT=3000

# `next dev` blocks cross-origin requests for its own dev assets, which breaks HMR when
# the app is opened through a tunnel or a LAN hostname. Comma-separated hostnames, no
# scheme or port: ALLOWED_DEV_ORIGINS="*.ngrok-free.app,my-box.local".
ALLOWED_DEV_ORIGINS=

# How many clips the worker renders at once. Keep this at 1 on a normal PC:
# each job runs ffmpeg + a headless Chrome (Remotion) render.
WORKER_CONCURRENCY=1

# Chrome tabs Remotion uses per render. Half your CPU cores is a sane default.
REMOTION_CONCURRENCY=

# Log level for the Remotion render: verbose | info | warn | error
REMOTION_LOG_LEVEL=info
